# Copy this file to ".env" and fill in real values there.
# .env is git-ignored and will never be committed.

# RPC endpoint for Sepolia (get a free one from alchemy.com or infura.io)
SEPOLIA_RPC_URL=

# Private key of your MetaMask test wallet (Sepolia only, no real funds)
# In MetaMask: Account details -> Show private key
PRIVATE_KEY=
